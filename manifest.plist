<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <dict>
            <key>assets</key>
            <array>
                <dict>
                    <key>kind</key>
                    <string>software-package</string>
                    <key>url</key>
                    <!-- Points to your raw IPA file hosted on GitHub Pages -->
                    <string>https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPO_NAME/aquila.ipa</string>
                </dict>
            </array>
            <key>metadata</key>
            <dict>
                <key>bundle-identifier</key>
                <!-- This must match the internal bundle ID of your signed Aquila IPA -->
                <string>com.example.aquila</string>
                <key>bundle-version</key>
                <string>1.0</string>
                <key>kind</key>
                <string>software</string>
                <key>title</key>
                <string>Aquila Jailbreak</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
